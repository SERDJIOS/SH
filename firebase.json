{
  "hosting": {
    "target": "main",
    "public": ".",
    "ignore": [
      "firebase.json",
      "firebase-debug.log",
      "**/.*",
      "**/node_modules/**",
      "Запись-экрана-*.mp4",
      "serhii-portrait.png",
      "serhii-portrait-back.png",
      "shot-*.jpg",
      "thumb-*.jpg",
      "IMG_*"
    ],
    "cleanUrls": true,
    "headers": [
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "**/*.@(jpg|jpeg|png|webp|mp4)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=604800"
          }
        ]
      },
      {
        "source": "fonts/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/impressum",
        "destination": "/legal",
        "type": 301
      },
      {
        "source": "/datenschutz",
        "destination": "/privacy",
        "type": 301
      }
    ]
  }
}
